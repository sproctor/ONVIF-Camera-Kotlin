<?xml version="1.0" encoding="UTF-8"?>
<!-- Derived by hand from a Media1 (trt:GetProfiles) capture of a camera with a main and a sub
     stream: the same tokens, names and encoder settings, restructured as the Media2 (tr2)
     GetProfilesResponse to a request with Type=VideoEncoder. Not a capture. -->
<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://www.w3.org/2003/05/soap-envelope"
                   xmlns:tt="http://www.onvif.org/ver10/schema"
                   xmlns:tr2="http://www.onvif.org/ver20/media/wsdl">
    <SOAP-ENV:Body>
        <tr2:GetProfilesResponse>
            <tr2:Profiles token="MediaProfile00000" fixed="true">
                <tr2:Name>MediaProfile_Channel1_MainStream</tr2:Name>
                <tr2:Configurations>
                    <tr2:VideoEncoder token="00000" GovLength="50" Profile="High">
                        <tt:Name>VideoEncoderConfig_Channel1_MainStream</tt:Name>
                        <tt:UseCount>1</tt:UseCount>
                        <tt:Encoding>H264</tt:Encoding>
                        <tt:Resolution>
                            <tt:Width>2592</tt:Width>
                            <tt:Height>1944</tt:Height>
                        </tt:Resolution>
                        <tt:RateControl ConstantBitRate="false">
                            <tt:FrameRateLimit>20.0</tt:FrameRateLimit>
                            <tt:BitrateLimit>6144</tt:BitrateLimit>
                        </tt:RateControl>
                        <tt:Quality>4.000000</tt:Quality>
                    </tr2:VideoEncoder>
                </tr2:Configurations>
            </tr2:Profiles>
            <tr2:Profiles token="MediaProfile00001" fixed="true">
                <tr2:Name>MediaProfile_Channel1_SubStream1</tr2:Name>
                <tr2:Configurations>
                    <tr2:VideoEncoder token="00001" GovLength="50" Profile="High">
                        <tt:Name>VideoEncoderConfig_Channel1_SubStream1</tt:Name>
                        <tt:UseCount>1</tt:UseCount>
                        <tt:Encoding>H264</tt:Encoding>
                        <tt:Resolution>
                            <tt:Width>704</tt:Width>
                            <tt:Height>480</tt:Height>
                        </tt:Resolution>
                        <tt:RateControl ConstantBitRate="false">
                            <tt:FrameRateLimit>20.0</tt:FrameRateLimit>
                            <tt:BitrateLimit>512</tt:BitrateLimit>
                        </tt:RateControl>
                        <tt:Quality>4.000000</tt:Quality>
                    </tr2:VideoEncoder>
                </tr2:Configurations>
            </tr2:Profiles>
        </tr2:GetProfilesResponse>
    </SOAP-ENV:Body>
</SOAP-ENV:Envelope>
