<?xml version="1.0" encoding="UTF-8"?>
<!-- Derived by hand from a Lorex LNB45ABB Media1 (trt:GetProfiles) capture: the same tokens and
     names, restructured as the Media2 (tr2) GetProfilesResponse to a request with
     Type=VideoEncoder. Not a capture. It keeps the capture's quirk: Profile000's video encoder
     configuration has a token and a name but no Encoding and no Resolution. -->
<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://www.w3.org/2003/05/soap-envelope"
                   xmlns:tt="http://www.onvif.org/ver10/schema"
                   xmlns:tr2="http://www.onvif.org/ver20/media/wsdl">
    <SOAP-ENV:Body>
        <tr2:GetProfilesResponse>
            <tr2:Profiles token="Profile000" fixed="true">
                <tr2:Name>Profile000</tr2:Name>
                <tr2:Configurations>
                    <tr2:VideoEncoder token="VideoEncoder000">
                        <tt:Name>VideoEncoder000</tt:Name>
                        <tt:UseCount>1</tt:UseCount>
                    </tr2:VideoEncoder>
                </tr2:Configurations>
            </tr2:Profiles>
            <tr2:Profiles token="Profile001" fixed="true">
                <tr2:Name>Profile001</tr2:Name>
                <tr2:Configurations>
                    <tr2:VideoEncoder token="VideoEncoder001" GovLength="30" Profile="Main">
                        <tt:Name>VideoEncoder001</tt:Name>
                        <tt:UseCount>1</tt:UseCount>
                        <tt:Encoding>H264</tt:Encoding>
                        <tt:Resolution>
                            <tt:Width>704</tt:Width>
                            <tt:Height>480</tt:Height>
                        </tt:Resolution>
                        <tt:RateControl ConstantBitRate="false">
                            <tt:FrameRateLimit>30.0</tt:FrameRateLimit>
                            <tt:BitrateLimit>1024</tt:BitrateLimit>
                        </tt:RateControl>
                        <tt:Quality>4.000000</tt:Quality>
                    </tr2:VideoEncoder>
                </tr2:Configurations>
            </tr2:Profiles>
        </tr2:GetProfilesResponse>
    </SOAP-ENV:Body>
</SOAP-ENV:Envelope>
